# Copy to .env and fill in. NEVER commit the real .env.

PORT=8080

# Avalanche C-Chain mainnet RPC (chainId 43114).
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# The gameServer hot key (same address as GAME_SERVER_ADDRESS in
# contracts/.env, DESIGN.md §13.2/§14.9) — this process signs every
# rewardTreasure/mintTreasure call with it. Treat this file as live funds.
GAME_SERVER_PRIVATE_KEY=0xREPLACE_ME_WITH_GAME_SERVER_PRIVATE_KEY

# Shared secret the frontend's Next.js proxy route sends as X-Relay-Secret.
# Server-only on the frontend side too (never a NEXT_PUBLIC_ var) — this is a
# light abuse deterrent, not real security (see index.ts comment), but a
# secret that never reaches the browser is meaningfully better than one that
# does.
RELAY_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
