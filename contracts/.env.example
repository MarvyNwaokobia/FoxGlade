# Copy to .env and fill in. NEVER commit the real .env.

# RPC endpoints — mainnet is the deploy target (DESIGN.md §14.9, no testnet
# stop). Fuji kept around only for local dry-runs if you ever want one.
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployer key — this now signs a REAL mainnet transaction with REAL AVAX gas.
# Use a DEDICATED deployer wallet funded with just enough for deployment, not
# a wallet holding other funds — deployment is irreversible. Never a key with
# real funds sitting in a repo, committed or not.
PRIVATE_KEY=0xREPLACE_ME_WITH_DEPLOYER_PRIVATE_KEY

# Contract verification (https://snowtrace.io)
SNOWTRACE_API_KEY=REPLACE_ME

# The single authorized game-server address that may mint treasures, credit
# VilleToken, submit Renown, trigger evolve, and record tournament scores.
# This key is the off-chain trust boundary (see DESIGN.md §13.2). Likely the
# signer for a Railway-hosted backend service.
GAME_SERVER_ADDRESS=0xREPLACE_ME_WITH_GAME_SERVER_ADDRESS

# Your Safe multisig — becomes the `owner`/admin of every contract (rotates
# gameServer, whitelists spenders, authorizes upgrades). If left unset, the
# deploy script falls back to the deployer address, which is WRONG for a real
# deploy (contracts are UUPS-upgradeable, §14.9 — whoever owns them can
# upgrade the logic). Set this before running with --broadcast.
SAFE_ADDRESS=0xREPLACE_ME_WITH_SAFE_ADDRESS
